{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yunaremaia/diff-contract/main/schema.json",
  "title": "DiffContract",
  "description": "Editor validation for version 1 DiffContract YAML files.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "default": 1 },
    "rules": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "patterns": {
      "description": "Python fnmatch patterns, not gitignore patterns. A leading ! is literal.",
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "limit": { "type": ["integer", "null"], "minimum": 0 },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "allow": { "$ref": "#/$defs/patterns" },
        "deny": { "$ref": "#/$defs/patterns" },
        "on_violation": { "enum": ["block", "warn", "info"], "default": "block" },
        "max_files": { "$ref": "#/$defs/limit" },
        "max_lines": { "$ref": "#/$defs/limit" }
      }
    }
  }
}
